{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Quota Ring",
  "version": "0.3.1",
  "identifier": "io.github.codexquotaring.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": { "csp": null },
    "windows": [{
      "label": "main",
      "title": "Codex Quota Ring",
      "width": 450,
      "height": 160,
      "minWidth": 450,
      "minHeight": 160,
      "maxWidth": 1080,
      "maxHeight": 780,
      "resizable": true,
      "decorations": false,
      "transparent": true,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "visible": true
    }]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "displayLanguageSelector": true, "languages": ["SimpChinese", "English"] } }
  }
}
